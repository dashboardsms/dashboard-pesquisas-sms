{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deve ser igual ao nome do Worker no painel da Cloudflare.
  "name": "dashboard-pesquisas-sms",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // O painel é uma SPA: rotas como /importar devolvem o index.html.
    "not_found_handling": "single-page-application",
    // Só a API passa pelo Worker; os demais arquivos saem direto dos assets.
    "run_worker_first": ["/api/*"]
  },
  // Namespace criado pelo wrangler no primeiro deploy; o id fixa os deploys seguintes nele.
  "kv_namespaces": [{ "binding": "DADOS", "id": "989658aa992445d587e3652f09fb66d1" }],
  // O painel publicado no GitHub Pages chama a API deste Worker a partir de outro domínio.
  "vars": { "ORIGENS_PERMITIDAS": "https://dashboardsms.github.io" },
  "observability": { "enabled": true }
}
